# Secrets and local config
.env
.env.*
!.env.example

# Data (raw and processed data are never committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts and local databases (reports are tracked)
artifacts/models/*
!artifacts/models/.gitkeep
*.db
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local uploads and generated browser-test screenshots
data/uploads/*
docs/screenshots/e2e/
