# Copy to .env.local to override. All variables are optional.

# Base URL of the EnergiQ API. Empty = same origin (the Vite dev server or nginx proxies /api and /health).
VITE_API_BASE=

# Client-side pre-check for uploads (the server limit, ENERGIQ_MAX_UPLOAD_MB, is authoritative).
VITE_MAX_UPLOAD_MB=50

# Dev/preview only: where the Vite proxy forwards /api and /health.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
