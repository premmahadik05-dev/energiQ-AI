# Copy to .env and fill in. NEVER commit .env. All application settings use the ENERGIQ_ prefix.

# --- Docker Compose (docker-compose.yml) ---
POSTGRES_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"   (prod refuses weak/default values)
ENERGIQ_SECRET_KEY=
# Optional: create the first administrator on start-up (leave empty to skip; change the password after first login)
ENERGIQ_ADMIN_EMAIL=
ENERGIQ_ADMIN_PASSWORD=
ENERGIQ_ALLOW_REGISTRATION=true
ENERGIQ_MAX_UPLOAD_MB=200

# --- Running the API directly (uvicorn backend.app.main:create_app --factory) ---
# ENERGIQ_ENV=dev                                       # dev | test | prod
# ENERGIQ_DATABASE_URL=sqlite:///./data/energiq.db      # or postgresql+psycopg://USER:PASSWORD@HOST:5432/energiq
# ENERGIQ_CORS_ORIGINS=["http://localhost:5173"]        # JSON list; wildcard is rejected in prod
# ENERGIQ_ACCESS_TOKEN_MINUTES=60
